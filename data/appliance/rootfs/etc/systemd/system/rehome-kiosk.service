# The VM, full screen: cage (a kiosk compositor) showing QEMU's display.
# Runs as the unprivileged "rehome" user with a login session on tty1, so it
# gets the seat (screen, keyboard, mouse) from logind.
[Unit]
Description=Rehome appliance: the VM, full screen
After=systemd-user-sessions.service systemd-logind.service rehome-firstboot.service
RequiresMountsFor=/var/lib/rehome
Conflicts=getty@tty1.service rehome-maintenance.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=rehome
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-fail
StandardOutput=tty
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
LimitMEMLOCK=infinity
# "+": these steps run as root (preparing, which also starts the watcher that
# clears the boot-failure flag once the VM is on screen; and afterwards,
# powering off or opening the maintenance console). No ExecStartPost: with
# TTYVHangup every command hangs up tty1, which would kill the running kiosk.
ExecStartPre=+/usr/local/bin/rehome appliance prepare
ExecStart=/usr/local/bin/rehome appliance kiosk
ExecStopPost=+/usr/local/bin/rehome appliance after-kiosk
