# The VM, full screen: cage (a kiosk compositor) showing QEMU's display.
# Runs as the unprivileged "rehome" user with a login session on tty1, so it
# gets the seat (screen, keyboard, mouse) from logind.
[Unit]
Description=Rehome appliance: the VM, full screen
After=systemd-user-sessions.service systemd-logind.service rehome-firstboot.service
Conflicts=getty@tty1.service rehome-maintenance.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=rehome
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-fail
StandardOutput=tty
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
LimitMEMLOCK=infinity
# "+": these steps run as root (preparing, clearing the boot-failure flag,
# and powering off or opening the maintenance console afterwards).
ExecStartPre=+/usr/local/bin/rehome appliance prepare
ExecStart=/usr/local/bin/rehome appliance kiosk
ExecStartPost=+/usr/local/bin/rehome appliance watch-boot
ExecStopPost=+/usr/local/bin/rehome appliance after-kiosk
